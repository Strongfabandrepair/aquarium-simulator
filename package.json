{
  "type": "module",
  "scripts": {
    "build": "esbuild js/main.js --bundle --outfile=bundle.js",
    "test:ui": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"js/**/*.js\"",
    "format": "prettier --write \"js/**/*.js\"",
    "start": "node server/index.js",
    "test:api": "node --test tests/persistence-api.node.js",
    "audit": "npm audit --audit-level=low"
  },
  "dependencies": {
    "three": "^0.128.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

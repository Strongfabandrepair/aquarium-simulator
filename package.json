{
  "type": "module",
  "scripts": {
    "build": "esbuild js/main.js --bundle --outfile=bundle.js",
    "test:ui": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"js/**/*.js\"",
    "format": "prettier --write \"js/**/*.js\"",
    "start": "node server/index.js",
    "test:api": "node --test tests/persistence-api.node.js"
  },
  "dependencies": {
    "three": "^0.128.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.3.3",
    "vitest": "^4.1.11"
  },
  "engines": { "node": ">=22.13.0" },
  "allowScripts": { "esbuild@0.28.2": true }
}
